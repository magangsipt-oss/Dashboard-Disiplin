PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dashboard_disiplin

# Wajib: kunci rahasia untuk menyamarkan identitas pelapor (mis. hasil `openssl rand -hex 32`).
# Jangan diganti setelah dipakai, atau laporan lama tidak muncul di Cek Laporan.
REPORTER_HASH_SECRET=

# Kunci enkripsi menu Data Password (Kemahasiswaan), 64 karakter hex (`openssl rand -hex 32`).
# Kosong = password hanya disimpan sebagai hash. Jangan diganti/dihapus setelah dipakai,
# atau password yang sudah tersimpan tidak bisa dibuka lagi.
PASSWORD_VAULT_KEY=

# Opsional: daftar origin dipisah koma bila frontend di domain lain.
CORS_ORIGIN=
# Opsional: setelan Express "trust proxy" (default: loopback).
TRUST_PROXY=

# Kosongkan SMTP_* untuk mode simulasi (email hanya dicatat di log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alamat EMAIL_FROM harus sama dengan SMTP_USER agar tidak dianggap palsu/spam.
EMAIL_FROM="Sistem Budaya Disiplin - Politeknik Simas Berau <akun@gmail.com>"
EMAIL_REPLY_TO=
EMAIL_ORG_NAME="Politeknik Simas Berau"
# Opsional: alamat portal yang ditautkan di email notifikasi (mis. https://disiplin.kampus.ac.id).
PORTAL_URL=

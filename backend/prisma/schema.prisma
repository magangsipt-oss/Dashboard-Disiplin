generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mahasiswa {
  id        Int      @id @default(autoincrement())
  nim       Int      @unique @map("NIM")
  nama      String   @map("Nama")
  password  String   @db.VarChar(255) @map("Password")
  jurusan   String   @map("Jurusan")
  timestamp DateTime @default(now())

  @@map("Mahasiswa")
}

model Dosen {
  id        Int      @id @default(autoincrement())
  nidn      BigInt   @unique @map("NIDN")
  nip       BigInt   @unique @map("NIP")
  nama      String   @map("Nama")
  password  String   @db.VarChar(255) @map("Password")
  timestamp DateTime @default(now())

  @@map("Dosen")
}

model Kemahasiswaan {
  id        Int      @id @default(autoincrement())
  nip       BigInt   @unique @map("NIP")
  nama      String   @map("Nama")
  password  String   @db.VarChar(255) @map("Password")
  timestamp DateTime @default(now())

  @@map("Kemahasiswaan")
}

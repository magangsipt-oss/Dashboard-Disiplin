generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mahasiswa {
  id          Int           @id @default(autoincrement()) @map("ID")
  nim         Int           @unique @map("NIM")
  nama        String        @map("Nama")
  password    String        @db.VarChar(255) @map("Password")
  jurusan     String        @map("Jurusan")
  pointScore  Int           @default(100) @map("Poin")
  timestamp   DateTime      @default(now()) @map("Timestamp")
  pointChanges PointChange[]
  dosenPaId   Int?          @map("DPA_ID")
  dosenPa     Dosen?        @relation(fields: [dosenPaId], references: [id], onDelete: SetNull)
  advisorRequest AdvisorRequest?

  @@map("Mahasiswa")
}

enum AdvisorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdvisorRequest {
  id           Int                  @id @default(autoincrement()) @map("ID")
  studentId    Int                  @unique(map: "Permohonan_DPA_mahasiswa_id_key") @map("Mahasiswa_ID")
  dosenId      Int                  @map("Dosen_ID")
  status       AdvisorRequestStatus @default(PENDING) @map("Status")
  createdAt    DateTime             @default(now()) @map("Pengajuan")
  reviewedAt   DateTime?            @map("Di_Setujui")
  student      Mahasiswa            @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "Permohonan_DPA_mahasiswa_id_fkey")
  dosen        Dosen                @relation(fields: [dosenId], references: [id], onDelete: Cascade, map: "Permohonan_DPA_dosen_id_fkey")

  @@index([dosenId, status, createdAt], map: "Permohonan_DPA_dosen_id_status_pengajuan_idx")
  @@map("Permohonan_DPA")
}
enum PointChangeType {
  LATE
  UNEXCUSED_ABSENCE
  DISCIPLINE_VIOLATION
  COMPETITION
  NON_ACADEMIC_ACTIVITY
}

model PointChange {
  id                  Int             @id @default(autoincrement())
  studentId           Int
  type                PointChangeType
  delta               Int
  scoreAfter          Int
  reason              String          @db.VarChar(500)
  recordedByIdentity  String          @db.VarChar(100)
  createdAt           DateTime        @default(now())
  student             Mahasiswa       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("PerubahanPoin")
}

model Dosen {
  id        Int      @id @default(autoincrement()) @map("ID")
  nidn      BigInt   @unique @map("NIDN")
  nip       BigInt   @unique @map("NIP")
  nama      String   @map("Nama")
  password  String   @db.VarChar(255) @map("Password")
  timestamp DateTime @default(now())
  mahasiswaBimbingan Mahasiswa[]
  advisorRequests    AdvisorRequest[]

  @@map("Dosen")
}

model Kemahasiswaan {
  id        Int      @id @default(autoincrement()) @map("ID")
  nip       BigInt   @unique @map("NIP")
  nama      String   @map("Nama")
  password  String   @db.VarChar(255) @map("Password")
  timestamp DateTime @default(now()) @map("Timestamp")

  @@map("Kemahasiswaan")
}

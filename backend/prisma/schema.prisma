generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mahasiswa {
  id                Int                @id @default(autoincrement()) @map("ID")
  nim               Int                @unique @map("NIM")
  nama              String             @map("Nama_Lengkap")
  noHandphone       String?            @map("No_Handphone") @db.VarChar(30)
  email             String?            @map("Email") @db.VarChar(255)
  password          String             @map("Password") @db.VarChar(255)
  jurusan           String             @map("PRODI")
  angkatan          Int?               @map("Angkatan")
  namaSmta          String?            @map("Nama_SMTA") @db.VarChar(255)
  dosenPaId         Int?               @map("DPA_ID")
  pointScore        Int                @default(100) @map("Poin")
  timestamp         DateTime           @default(now()) @map("Timestamp")
  pointChanges      PointChange[]
  dosenPa           Dosen?             @relation(fields: [dosenPaId], references: [id], onDelete: SetNull)
  laporanTerlapor   Laporan[]
  presensiAkademik  PresensiAkademik[]
  advisorRequest    AdvisorRequest?
  counselingRecords CounselingRecord[]
  sanggahans        Sanggahan[]
  pembinaans        Pembinaan[]
  pemberitahuan     Pemberitahuan[]
  klaimKegiatan     KlaimKegiatan[]

  @@index([dosenPaId])
  @@map("Mahasiswa")
}

enum AdvisorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdvisorRequest {
  id         Int                  @id @default(autoincrement()) @map("ID")
  studentId  Int                  @unique(map: "Permohonan_DPA_mahasiswa_id_key") @map("Mahasiswa_ID")
  dosenId    Int                  @map("Dosen_ID")
  status     AdvisorRequestStatus @default(PENDING) @map("Status")
  createdAt  DateTime             @default(now()) @map("Pengajuan")
  reviewedAt DateTime?            @map("Di_Setujui")
  student    Mahasiswa            @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "Permohonan_DPA_mahasiswa_id_fkey")
  dosen      Dosen                @relation(fields: [dosenId], references: [id], onDelete: Cascade, map: "Permohonan_DPA_dosen_id_fkey")

  @@index([dosenId, status, createdAt], map: "Permohonan_DPA_dosen_id_status_pengajuan_idx")
  @@map("Permohonan_DPA")
}

enum CounselingRecordType {
  GUIDANCE_NOTE
  COUNSELING_CALL
}

model CounselingRecord {
  id             Int                  @id @default(autoincrement())
  studentId      Int
  dosenId        Int
  type           CounselingRecordType
  note           String               @db.VarChar(2000)
  counselingDate DateTime             @db.Date
  createdAt      DateTime             @default(now())
  student        Mahasiswa            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dosen          Dosen                @relation(fields: [dosenId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([dosenId, studentId, createdAt])
  @@map("CatatanKonseling")
}

enum PointChangeType {
  LATE
  UNEXCUSED_ABSENCE
  DISCIPLINE_VIOLATION
  COMPETITION
  NON_ACADEMIC_ACTIVITY
  REPORTED_VIOLATION
  POINT_RESTORATION
  PUNISHMENT_PENALTY
}

enum DisciplinePillar {
  WAKTU
  AKADEMIK
  TATA_TERTIB
  PROSEDUR_K3
  LINGKUNGAN
}

enum ViolationSeverity {
  RINGAN
  SEDANG
  BERAT
  SANGAT_BERAT
}

model PointChange {
  id                 Int                @id @default(autoincrement())
  studentId          Int
  type               PointChangeType
  pillar             DisciplinePillar?
  severity           ViolationSeverity?
  delta              Int
  scoreAfter         Int
  reason             String             @db.VarChar(500)
  recordedByIdentity String             @db.VarChar(100)
  createdAt          DateTime           @default(now())
  student            Mahasiswa          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sanggahans         Sanggahan[]
  pembinaans         Pembinaan[]
  laporan            Laporan?
  klaimKegiatan      KlaimKegiatan?

  @@index([studentId, createdAt])
  @@index([studentId, pillar])
  @@index([studentId, type])
  @@map("PerubahanPoin")
}

// Laporan hanya untuk pelanggaran; laporan apresiasi sudah dihapus.
enum JenisLaporan {
  TEMUAN
}

enum StatusLaporan {
  DITERIMA
  DIVERIFIKASI
  DITINDAKLANJUTI
  SELESAI
  DITOLAK
}

enum JalurLaporan {
  TERIDENTIFIKASI
  TIDAK_TERDAFTAR
  TIDAK_DIKETAHUI
}

enum PeranPenerima {
  DOSEN
  KEMAHASISWAAN
}

enum StatusSanggahan {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

enum JenisPembinaan {
  REFLEKSI_TERTULIS
  KONSELING
  TUGAS_EDUKATIF
}

enum StatusPembinaan {
  DIMINTA
  DIKIRIM
  DISETUJUI
  DITOLAK
}

model AturanPelanggaran {
  id        Int               @id @default(autoincrement())
  pillar    DisciplinePillar
  nama      String            @db.VarChar(200)
  severity  ViolationSeverity
  bobotPoin Int
  aktif     Boolean           @default(true)
  laporan   Laporan[]

  @@unique([pillar, nama])
  @@index([pillar, aktif])
}

model Laporan {
  id                     Int                 @id @default(autoincrement())
  kodeHash               String              @unique @db.Char(64)
  jenis                  JenisLaporan        @default(TEMUAN)
  pillar                 DisciplinePillar
  aturanId               Int?
  severityUsulan         ViolationSeverity?
  terlaporNama           String?             @db.VarChar(200)
  terlaporNim            String?             @db.VarChar(32)
  terlaporKeterangan     String?             @db.VarChar(500)
  terlaporId             Int?
  jalur                  JalurLaporan        @default(TIDAK_DIKETAHUI)
  lokasi                 String              @db.VarChar(300)
  tanggalKejadian        DateTime            @db.Date
  deskripsi              String              @db.VarChar(1000)
  buktiPath              String?             @db.VarChar(500)
  tanggalLapor           DateTime            @default(now()) @db.Date
  status                 StatusLaporan       @default(DITERIMA)
  catatanUntukPelapor    String?             @db.VarChar(1000)
  diverifikasiOlehId     Int?
  tanggalVerifikasi      DateTime?
  dikonfirmasiDosenId    Int?
  tanggalKonfirmasiDosen DateTime?
  perubahanPoinId        Int?                @unique
  // Diisi saat Kemahasiswaan melengkapi identitas terlapor, agar laporan tetap
  // tampil di Antrean Laporan sampai Dosen PA memutuskan.
  ditelusuriPada         DateTime?
  terlapor               Mahasiswa?          @relation(fields: [terlaporId], references: [id], onDelete: SetNull)
  aturan                 AturanPelanggaran?  @relation(fields: [aturanId], references: [id], onDelete: SetNull)
  diverifikasiOleh       Akademik?           @relation(fields: [diverifikasiOlehId], references: [id], onDelete: SetNull)
  dikonfirmasiDosen      Dosen?              @relation("LaporanDosenKonfirmasi", fields: [dikonfirmasiDosenId], references: [id], onDelete: SetNull)
  perubahanPoin          PointChange?        @relation(fields: [perubahanPoinId], references: [id], onDelete: SetNull)
  pemberitahuanStaf      PemberitahuanStaf[]

  @@index([status, id])
  @@index([terlaporNim, status])
  @@index([terlaporId, status])
  @@index([ditelusuriPada])
}

// Foto bukti laporan disimpan di database agar bisa dilihat dari backend
// mana pun yang memakai database yang sama. Laporan.buktiPath menunjuk ke
// "/uploads/evidence/<fileName>".
model BuktiFoto {
  fileName  String   @id @db.VarChar(64)
  mimeType  String   @db.VarChar(20)
  data      Bytes
  createdAt DateTime @default(now())
}

model Sanggahan {
  id               Int             @id @default(autoincrement())
  perubahanPoinId  Int
  studentId        Int
  alasan           String          @db.VarChar(2000)
  status           StatusSanggahan @default(DIAJUKAN)
  catatanPemeriksa String?         @db.VarChar(1000)
  createdAt        DateTime        @default(now())
  reviewedAt       DateTime?
  perubahanPoin    PointChange     @relation(fields: [perubahanPoinId], references: [id], onDelete: Cascade)
  student          Mahasiswa       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([perubahanPoinId, status])
}

model Pembinaan {
  id                  Int             @id @default(autoincrement())
  perubahanPoinId     Int
  studentId           Int
  jenis               JenisPembinaan
  instruksi           String          @db.VarChar(2000)
  status              StatusPembinaan @default(DIMINTA)
  isiRefleksi         String?         @db.VarChar(5000)
  buktiUrl            String?         @db.VarChar(2000)
  catatanPemeriksa    String?         @db.VarChar(1000)
  // Punishment dari Kemahasiswaan: lewat batas waktu tanpa tindak lanjut,
  // poin dipotong per hari. dendaDihitungSampai = tanggal terakhir yang
  // sudah dihitung dendanya (atau dijeda saat bukti sedang diperiksa).
  batasWaktu          DateTime?       @db.Date
  dendaDihitungSampai DateTime?       @db.Date
  hariDenda           Int             @default(0)
  totalDenda          Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  perubahanPoin       PointChange     @relation(fields: [perubahanPoinId], references: [id], onDelete: Cascade)
  student             Mahasiswa       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status, createdAt])
  @@index([status, batasWaktu])
}

enum JenisKlaimKegiatan {
  LOMBA
  KEGIATAN_NON_AKADEMIK
}

enum TingkatKegiatan {
  KAMPUS
  KABUPATEN_KOTA
  PROVINSI
  NASIONAL
  INTERNASIONAL
}

enum StatusKlaimKegiatan {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

// Klaim poin tambahan dari lomba/kegiatan non-akademik. File sertifikat atau
// dokumentasi disimpan di tabel BuktiFoto (JPEG, PNG, atau PDF).
model KlaimKegiatan {
  id               Int                 @id @default(autoincrement())
  studentId        Int
  jenis            JenisKlaimKegiatan
  namaKegiatan     String              @db.VarChar(200)
  penyelenggara    String              @db.VarChar(200)
  tingkat          TingkatKegiatan
  capaian          String              @db.VarChar(100)
  tanggalKegiatan  DateTime            @db.Date
  deskripsi        String?             @db.VarChar(1000)
  buktiFileName    String              @db.VarChar(64)
  status           StatusKlaimKegiatan @default(DIAJUKAN)
  poinDisetujui    Int?
  catatanPemeriksa String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now())
  reviewedAt       DateTime?
  perubahanPoinId  Int?                @unique
  student          Mahasiswa           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  perubahanPoin    PointChange?        @relation(fields: [perubahanPoinId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

model Pemberitahuan {
  id        Int       @id @default(autoincrement())
  studentId Int
  judul     String    @db.VarChar(200)
  isi       String    @db.VarChar(1000)
  tautanTab String?   @db.VarChar(100)
  dibaca    Boolean   @default(false)
  createdAt DateTime  @default(now())
  student   Mahasiswa @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dibaca, createdAt])
}

model PemberitahuanStaf {
  id        Int           @id @default(autoincrement())
  peran     PeranPenerima
  dosenId   Int?
  laporanId Int?
  judul     String        @db.VarChar(200)
  isi       String        @db.VarChar(1000)
  tautanTab String?       @db.VarChar(100)
  dibaca    Boolean       @default(false)
  createdAt DateTime      @default(now())
  dosen     Dosen?        @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  laporan   Laporan?      @relation(fields: [laporanId], references: [id], onDelete: Cascade)

  @@index([peran, dosenId, dibaca, createdAt])
}

model LogAudit {
  id         Int      @id @default(autoincrement())
  aktorId    Int
  aktorPeran String?  @db.VarChar(20)
  aksi       String   @db.VarChar(100)
  entitas    String   @db.VarChar(100)
  entitasId  Int
  createdAt  DateTime @default(now())

  @@index([aktorId, createdAt])
  @@index([entitas, entitasId])
}

model Sesi {
  tokenHash String   @id @db.Char(64)
  profile   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Dosen {
  id                  Int                 @id @default(autoincrement()) @map("ID")
  email               String?             @map("Email") @db.VarChar(255)
  nuptk               BigInt              @unique @map("NUPTK")
  nama                String              @map("Nama")
  password            String              @map("Password") @db.VarChar(255)
  timestamp           DateTime            @default(now()) @map("Timestamp")
  mahasiswaBimbingan  Mahasiswa[]
  advisorRequests     AdvisorRequest[]
  laporanDikonfirmasi Laporan[]           @relation("LaporanDosenKonfirmasi")
  counselingRecords   CounselingRecord[]
  pemberitahuanStaf   PemberitahuanStaf[]

  @@map("Dosen")
}

model Kemahasiswaan {
  id        Int      @id @default(autoincrement()) @map("ID")
  email     String?  @unique @map("Email") @db.VarChar(255)
  nama      String   @map("Nama")
  password  String   @map("Password") @db.VarChar(255)
  timestamp DateTime @default(now()) @map("Timestamp")

  @@map("Kemahasiswaan")
}

model Akademik {
  id                  Int       @id @default(autoincrement()) @map("ID")
  email               String?   @unique @map("Email") @db.VarChar(255)
  nama                String    @map("Nama")
  password            String    @map("Password") @db.VarChar(255)
  timestamp           DateTime  @default(now()) @map("Timestamp")
  laporanDiverifikasi Laporan[]

  @@map("Akademik")
}

model PresensiAkademik {
  id              Int       @id @default(autoincrement()) @map("ID")
  mataKuliah      String    @map("Mata_Kuliah")
  kelas           String    @map("Kelas")
  nim             Int       @map("NIM")
  namaMahasiswa   String    @map("Nama_Mahasiswa")
  jumlahKehadiran Int       @map("Jumlah_Kehadiran")
  timestamp       DateTime  @default(now()) @map("Timestamp")
  mahasiswa       Mahasiswa @relation(fields: [nim], references: [nim], onDelete: Cascade)

  @@unique([mataKuliah, kelas, nim])
  @@index([mataKuliah, kelas])
  @@map("PresensiAkademik")
}

model UnggahanAkademik {
  id             String   @id @db.VarChar(64)
  category       String   @db.VarChar(20)
  fileName       String   @db.VarChar(255)
  storedFileName String   @db.VarChar(320)
  fileSize       Int
  uploadedAt     DateTime @default(now())
  uploadedBy     String   @db.VarChar(255)
  rowCount       Int
  summary        String   @db.VarChar(500)

  @@index([category, uploadedAt])
}
